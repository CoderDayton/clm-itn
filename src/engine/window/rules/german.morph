OPTION case lower

LEXICON Root
  0        Group1 ;
  tausend  THO  Rest ;

LEXICON Rest
  0        # ;
  und      AND  Below2 ;
  0        Group2 ;

LEXICON Group1
  ein      D    Hund1 ;
  zwei     D    Hund1 ;
  zwo      D    Hund1 ;
  drei     D    Hund1 ;
  vier     D    Hund1 ;
  fünf     D    Hund1 ;
  sechs    D    Hund1 ;
  sieben   D    Hund1 ;
  acht     D    Hund1 ;
  neun     D    Hund1 ;
  hundert  HUN  After1 ;
  0        Below1 ;
  elf      B    Year ;
  zwölf    B    Year ;
  dreizehn B    Year ;
  vierzehn B    Year ;
  fünfzehn B    Year ;
  sechzehn B    Year ;
  siebzehn B    Year ;
  achtzehn B    Year ;
  neunzehn B    Year ;

LEXICON Year
  hundert  HUN  After2 ;

LEXICON Hund1
  hundert  HUN  After1 ;

LEXICON After1
  0        End1 ;
  und      AND  Below1 ;
  0        Below1 ;

LEXICON Below1
  eins     D    # ;
  ein      D    One1 ;
  zwei     D    Digit1 ;
  zwo      D    Digit1 ;
  drei     D    Digit1 ;
  vier     D    Digit1 ;
  fünf     D    Digit1 ;
  sechs    D    Digit1 ;
  sieben   D    Digit1 ;
  acht     D    Digit1 ;
  neun     D    Digit1 ;
  zehn     B    End1 ;
  elf      B    End1 ;
  zwölf    B    End1 ;
  dreizehn B    End1 ;
  vierzehn B    End1 ;
  fünfzehn B    End1 ;
  sechzehn B    End1 ;
  siebzehn B    End1 ;
  achtzehn B    End1 ;
  neunzehn B    End1 ;
  0        Tens1 ;

LEXICON One1
  und      AND  Tens1 ;
  tausend  THO  Rest ;

LEXICON Digit1
  0        End1 ;
  und      AND  Tens1 ;

LEXICON Tens1
  zwanzig  B    End1 ;
  dreißig  B    End1 ;
  dreissig B    End1 ;
  vierzig  B    End1 ;
  fünfzig  B    End1 ;
  sechzig  B    End1 ;
  siebzig  B    End1 ;
  achtzig  B    End1 ;
  neunzig  B    End1 ;

LEXICON End1
  0        # ;
  tausend  THO  Rest ;

LEXICON Group2
  ein      D    Hund2 ;
  zwei     D    Hund2 ;
  zwo      D    Hund2 ;
  drei     D    Hund2 ;
  vier     D    Hund2 ;
  fünf     D    Hund2 ;
  sechs    D    Hund2 ;
  sieben   D    Hund2 ;
  acht     D    Hund2 ;
  neun     D    Hund2 ;
  hundert  HUN  After2 ;
  0        Below2 ;

LEXICON Hund2
  hundert  HUN  After2 ;

LEXICON After2
  0        # ;
  und      AND  Below2 ;
  0        Below2 ;

LEXICON Below2
  eins     D    # ;
  ein      D    One2 ;
  zwei     D    Digit2 ;
  zwo      D    Digit2 ;
  drei     D    Digit2 ;
  vier     D    Digit2 ;
  fünf     D    Digit2 ;
  sechs    D    Digit2 ;
  sieben   D    Digit2 ;
  acht     D    Digit2 ;
  neun     D    Digit2 ;
  zehn     B    # ;
  elf      B    # ;
  zwölf    B    # ;
  dreizehn B    # ;
  vierzehn B    # ;
  fünfzehn B    # ;
  sechzehn B    # ;
  siebzehn B    # ;
  achtzehn B    # ;
  neunzehn B    # ;
  0        Tens2 ;

LEXICON One2
  und      AND  Tens2 ;

LEXICON Digit2
  0        # ;
  und      AND  Tens2 ;

LEXICON Tens2
  zwanzig  B    # ;
  dreißig  B    # ;
  dreissig B    # ;
  vierzig  B    # ;
  fünfzig  B    # ;
  sechzig  B    # ;
  siebzig  B    # ;
  achtzig  B    # ;
  neunzig  B    # ;
